# PostgreSQL runtime pooler connection (server only).
DATABASE_URL=
# Operator direct/session connection for Prisma migrations.
DIRECT_URL=

APP_ORIGIN=http://127.0.0.1:3000
AUTH_URL=http://127.0.0.1:3000
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Local development: accounts can sign in immediately.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Local testing only. Set true to require administrator authenticator codes again.
# Non-local APP_ORIGIN always requires administrator MFA.
AUTH_REQUIRE_ADMIN_MFA=false
# local writes account links to the ignored docs/auth-outbox.local.md.
# Use smtp when a mail provider is configured.
AUTH_EMAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

R2_ACCOUNT_ID=
R2_BUCKET=gochitral-media-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
