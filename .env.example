# Server-only runtime connection. Use a restricted LOGIN role granted gochitral_public.
DATABASE_URL=
# Operator connection for Prisma migrations and development seed. Use a direct or session connection.
DIRECT_URL=

# Supabase Auth project address and Publishable key from Connect or Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000
