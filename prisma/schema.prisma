generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  destinations
  activities
  hotels
  guides
}

enum PublicationStatus {
  draft
  published
  suspended
}

enum RevisionStatus {
  draft
  pending
  approved
}

enum AccountRole {
  tourist
  manager
  administrator
}

model Account {
  id   String @id @db.Uuid
  role AccountRole @default(tourist)
}

model AuthRateLimit {
  key       String @id
  window    DateTime
  attempts  Int
}

model Listing {
  id                  String @id
  category            Category
  slug                String
  title               String
  location            String
  summary             String
  description         String
  visitorNote         String
  reviewed            DateTime @db.Date
  status              PublicationStatus @default(draft)
  sourceTitle         String?
  sourceUrl           String?
  displayOrder        Int @default(0)
  destinationId       String?
  destinationCategory Category?
  destination         Listing? @relation("Destination", fields: [destinationId, destinationCategory], references: [id, category], onDelete: Restrict)
  related             Listing[] @relation("Destination")
  photoId             String
  photo               Media @relation(fields: [photoId], references: [id], onDelete: Restrict)
  rooms               Room[]
  ownership           HotelOwnership?
  verification        GuideVerification?
  version             Int @default(1)
  contactUrl          String?
  latitude            Float?
  longitude           Float?
  revision            ListingRevision?
  audits              AuditEntry[]

  @@unique([id, category])
  @@unique([category, slug])
  @@index([status, displayOrder, id])
  @@index([destinationId])
}

model ListingRevision {
  listingId String @id
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  version   Int
  status    RevisionStatus @default(draft)
  payload   Json
  updatedAt DateTime @updatedAt
}

model AuditEntry {
  id                 String @id @default(uuid())
  listingId          String
  listing            Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  actorId            String @db.Uuid
  action             String
  reason             String
  revision           Int
  createdAt          DateTime @default(now())
  dependentTripCount Int @default(0)
  @@index([listingId, createdAt])
}

model Media {
  id       String @id
  src      String @unique
  width    Int
  height   Int
  alt      String
  caption  String
  author   String
  original String
  license  String
  listings Listing[]
}

model Room {
  id            String @id @default(uuid())
  hotelId       String
  hotelCategory Category @default(hotels)
  hotel         Listing @relation(fields: [hotelId, hotelCategory], references: [id, category], onDelete: Restrict)
  title         String
  capacity      Int
  nightlyMinor  Int?
  currency      String @default("PKR")
  status        PublicationStatus @default(draft)
  @@index([hotelId])
}

// No public policies or grants. Auth ownership workflows arrive in Modules 04–06.
model HotelOwnership {
  hotelId String @id
  hotel   Listing @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  ownerId String
}

model GuideVerification {
  guideId String @id
  guide   Listing @relation(fields: [guideId], references: [id], onDelete: Restrict)
  evidence String
}
